<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.yuki</groupId>
        <artifactId>reactorsched</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>reactorsched-executor-sdk</artifactId>
    <name>reactorsched-executor-sdk</name>
    <description>Executor process SDK: registration, heartbeat, pull-based claiming, bounded thread pool, cooperative timeout watchdog, lease renewal, graceful shutdown</description>

    <dependencies>
        <!-- The whole compile contract of an executor process: no Spring web server, no MyBatis, no JDBC. -->
        <dependency>
            <groupId>com.yuki</groupId>
            <artifactId>reactorsched-executor-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- RestClient + the JDK request factory: the executor talks HTTP, it does not serve HTTP. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
