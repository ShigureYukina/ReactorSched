<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.yuki</groupId>
    <artifactId>reactorsched</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ReactorSched</name>
    <description>Distributed task scheduling platform: scheduler and executors separated, MySQL as the single source of truth</description>

    <modules>
        <module>reactorsched-common</module>
        <module>reactorsched-core</module>
        <module>reactorsched-api</module>
        <module>reactorsched-worker</module>
        <module>reactorsched-recovery</module>
        <module>reactorsched-scheduler</module>
        <module>reactorsched-executor-api</module>
        <module>reactorsched-executor-registry</module>
        <module>reactorsched-executor-sdk</module>
        <module>reactorsched-faultlab</module>
        <module>reactorsched-adaptive</module>
        <module>reactorsched-observability</module>
        <module>reactorsched-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yuki</groupId>
                <artifactId>reactorsched-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yuki</groupId>
                <artifactId>reactorsched-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yuki</groupId>
                <artifactId>reactorsched-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yuki</groupId>
                <artifactId>reactorsched-worker</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yuki</groupId>
                <artifactId>reactorsched-recovery</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yuki</groupId>
                <artifactId>reactorsched-scheduler</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yuki</groupId>
                <artifactId>reactorsched-executor-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yuki</groupId>
                <artifactId>reactorsched-executor-registry</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yuki</groupId>
                <artifactId>reactorsched-executor-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yuki</groupId>
                <artifactId>reactorsched-faultlab</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yuki</groupId>
                <artifactId>reactorsched-adaptive</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yuki</groupId>
                <artifactId>reactorsched-observability</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
