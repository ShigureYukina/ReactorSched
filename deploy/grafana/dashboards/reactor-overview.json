 "panels": [
  {
   "datasource": {
    "type": "prometheus",
    "uid": "reactorsched-prometheus"
   },
   "description": "终态 attempt 的速率，按 result 拆分。成功率 = SUCCEEDED / (SUCCEEDED + FAILED)。",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "unit": "reqps"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 0
   },
   "id": 1,
   "options": {
    "legend": {
     "calcs": [
      "mean",
      "max"
     ],
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "reactorsched-prometheus"
     },
     "editorMode": "code",
     "expr": "sum by (result) (rate(reactorsched_task_completed_total[5m]))",
     "legendFormat": "{{result}}",
     "range": true,
     "refId": "A"
    }
   ],
   "title": "任务完成速率（按结果）",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "reactorsched-prometheus"
   },
   "description": "执行耗时的 P50/P95/P99，来自 Timer 的 histogram 桶（PRD 8.6 禁止用平均值冒充分布）。",
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 0
   },
   "id": 2,
   "options": {
    "legend": {
     "calcs": [
      "mean",
      "max"
     ],
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "reactorsched-prometheus"
     },
     "editorMode": "code",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(reactorsched_task_execution_duration_seconds_bucket[5m])))",
     "legendFormat": "P99",
     "range": true,
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "reactorsched-prometheus"
     },
     "editorMode": "code",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(reactorsched_task_execution_duration_seconds_bucket[5m])))",
     "legendFormat": "P95",
     "range": true,
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "reactorsched-prometheus"
     },
     "editorMode": "code",
     "expr": "histogram_quantile(0.50, sum by (le) (rate(reactorsched_task_execution_duration_seconds_bucket[5m])))",
     "legendFormat": "P50",
     "range": true,
     "refId": "C"
    }
   ],
   "title": "执行耗时分布（P50 / P95 / P99）",
   "type": "timeseries"
  },
