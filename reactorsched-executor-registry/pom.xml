<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.yuki</groupId>
        <artifactId>reactorsched</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>reactorsched-executor-registry</artifactId>
    <name>reactorsched-executor-registry</name>
    <description>Executor registry: registration, heartbeat, offline sweep, group routing, claim and result submission for remote executors</description>

    <dependencies>
        <dependency>
            <groupId>com.yuki</groupId>
            <artifactId>reactorsched-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yuki</groupId>
            <artifactId>reactorsched-executor-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- Request DTOs carry their constraints (AGENTS.md 11); the API module binds them. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
